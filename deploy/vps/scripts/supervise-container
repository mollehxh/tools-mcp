#!/bin/sh
set -eu

fail() { printf 'STOP: %s\n' "$*" >&2; exit 1; }
: "${TOOLS_MCP_CONTAINER:?TOOLS_MCP_CONTAINER is required}"
command -v podman >/dev/null || fail "podman is unavailable"
command -v systemd-notify >/dev/null || fail "systemd-notify is unavailable"

cleanup() {
  podman stop --time 10 "$TOOLS_MCP_CONTAINER" >/dev/null 2>&1 || true
}
trap cleanup EXIT HUP INT TERM

podman start "$TOOLS_MCP_CONTAINER" >/dev/null
/opt/tools-mcp/current/libexec/configure-egress
/opt/tools-mcp/current/libexec/verify-container
systemd-notify --ready
podman wait "$TOOLS_MCP_CONTAINER" >/dev/null

# A container exit outside an intentional systemd stop must be recovered.
exit 1
