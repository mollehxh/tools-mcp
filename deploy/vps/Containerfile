FROM ubuntu:26.04@sha256:889d056d5c6c0bfb55789ff3710681d68e50713cb562d2196dc07110599c7a6f

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential ca-certificates clang cmake curl fd-find git gh golang-go jq \
      nodejs npm openssh-client pkg-config python3 python3-pip python3-venv \
      ripgrep rustc cargo tmux wget \
 && ln -s /usr/bin/fdfind /usr/local/bin/fd \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

COPY container/tool-versions.sh /usr/local/bin/tools-mcp-tool-versions
RUN chmod 0755 /usr/local/bin/tools-mcp-tool-versions \
 && tools-mcp-tool-versions > /usr/local/share/tools-mcp-tool-versions.txt

# OpenSSH resolves root's home through /etc/passwd instead of the HOME
# environment variable. Keep its config and keys in the persistent user home.
RUN mkdir -p /home/developer \
 && rm -rf /root/.ssh \
 && ln -s /home/developer/.ssh /root/.ssh

ENV HOME=/home/developer
WORKDIR /workspace
CMD ["sleep", "infinity"]
