#!/bin/sh
set -eu

fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || fail "storage fixture requires root"
temporary=$(mktemp -d)
cleanup() {
  mountpoint -q "$temporary/bytes" && umount "$temporary/bytes" || true
  mountpoint -q "$temporary/inodes" && umount "$temporary/inodes" || true
  rm -rf -- "$temporary"
}
trap cleanup EXIT HUP INT TERM
mkdir "$temporary/bytes" "$temporary/inodes"
truncate -s 32M "$temporary/bytes.ext4"
truncate -s 32M "$temporary/inodes.ext4"
mkfs.ext4 -q -F -m 0 "$temporary/bytes.ext4"
mkfs.ext4 -q -F -m 0 -N 64 "$temporary/inodes.ext4"
mount -o loop,nosuid,nodev "$temporary/bytes.ext4" "$temporary/bytes"
mount -o loop,nosuid,nodev "$temporary/inodes.ext4" "$temporary/inodes"

if dd if=/dev/zero of="$temporary/bytes/fill" bs=1M count=64 conv=fsync 2>/dev/null; then
  fail "byte-limited filesystem did not reach ENOSPC"
fi
count=0
while touch "$temporary/inodes/file-$count" 2>/dev/null; do
  count=$((count + 1))
  [ "$count" -lt 1000 ] || fail "inode-limited filesystem did not exhaust"
done
[ "$count" -gt 0 ] || fail "inode fixture could not create its first file"

touch "$temporary/host-remains-writable"
test -f "$temporary/host-remains-writable"
printf 'storage ENOSPC and inode isolation fixture passed\n'
