TOOLS_MCP_ISSUER=https://fidela-unsubversive-imaginarily.ngrok-free.dev/
TOOLS_MCP_CLIENT_ID=https://chatgpt.com/oauth/5rmDqoFrYfK7/client.json
TOOLS_MCP_REDIRECT_URI=https://chatgpt.com/connector/oauth/5rmDqoFrYfK7
TOOLS_MCP_OWNER_HASH_FILE=/etc/tools-mcp/owner-secret.phc
TOOLS_MCP_TOKEN_HASH_KEY_FILE=/etc/tools-mcp/token-hash.key
TOOLS_MCP_DATABASE=/var/lib/tools-mcp/gateway/gateway.sqlite3
TOOLS_MCP_WATERMARK=/var/lib/tools-mcp/gateway/allocator.watermark
TOOLS_MCP_TLS_CERT=/etc/tools-mcp/pki/gateway/server.pem
TOOLS_MCP_TLS_KEY=/etc/tools-mcp/pki/gateway/server.key
TOOLS_MCP_DEVICE_CA=/etc/tools-mcp/pki/gateway/device-ca.pem
TOOLS_MCP_DEVICE_CA_ISSUER_CERT=/root/.tools-mcp-ca/ca.pem
TOOLS_MCP_DEVICE_CA_ISSUER_KEY=/root/.tools-mcp-ca/ca.key
TOOLS_MCP_BIND=127.0.0.1:8443
TOOLS_MCP_RELAY_BIND=127.0.0.1:8445
TOOLS_MCP_OPENAI_HEADER_SALT=replace-with-random-value
TOOLS_MCP_SYSTEM_SKILL_MANIFEST_ALLOWLIST=replace-with-exact-lowercase-sha256-digest
TOOLS_MCP_HOST_METRICS_FILE=/var/lib/tools-mcp/metrics/host.prom
